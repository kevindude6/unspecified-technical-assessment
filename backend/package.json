{
  "name": "backend",
  "type": "module",
  "scripts": {
    "dev": "dotenv -e .env.dev -- tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "pnpm biome lint --write --unsafe",
    "test": "dotenv -e .env.test -- vitest run",
    "test:watch": "dotenv -e .env.test -- vitest",
    "test:coverage": "dotenv -e .env.test -- vitest run --coverage",
    "db:test:up": "docker-compose up -d postgres-test",
    "db:test:down": "docker-compose down postgres-test -v"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.6",
    "@hono/standard-validator": "^0.2.1",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "arktype": "^2.1.29",
    "dotenv": "^17.2.3",
    "hono": "^4.11.3",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "@types/node": "^20.11.17",
    "@types/pg": "^8.16.0",
    "@vitest/coverage-v8": "^4.0.16",
    "dotenv-cli": "^8.0.0",
    "prisma": "^7.2.0",
    "tsx": "^4.7.1",
    "typescript": "^5.8.3",
    "vitest": "^4.0.16"
  }
}
